# ==============================================================================
# Kasma Tech Shop - Production & Development Environment Configuration
# ==============================================================================

# 1. Database (Neon / Cloud SQL PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SQL_HOST="host"
SQL_DB_NAME="dbname"
SQL_USER="user"
SQL_PASSWORD="password"

# 2. Security & Administrator Authentication
JWT_SECRET="kasma-super-secret-jwt-key-2026-secure-ethiopia"
ADMIN_USERNAME="kasma-admin"
ADMIN_PASSWORD="strong_admin_password_here"

# 3. Chapa Payment Rails (Telebirr, CBE Birr, Awash, Bank Cards)
# Obtain from https://dashboard.chapa.co/
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxx"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxx"
CHAPA_WEBHOOK_SECRET="kasma_chapa_webhook_secret_2026"
CHAPA_BASE_URL="https://api.chapa.co/v1"

# 4. Ethiopian SMS Gateway (AfroMessage & Ethio Telecom)
# Sign up at https://afromessage.com/ to send live SMS OTPs & COD delivery PINs to Ethio Telecom / Safaricom numbers
AFROMESSAGE_API_KEY="your_afromessage_api_key_here"
AFROMESSAGE_SENDER_NAME="KASMA"
AFROMESSAGE_IDENTIFIER_ID=""

# Optional Ethio Telecom direct gateway
ETHIO_TELECOM_SMS_URL=""
ETHIO_TELECOM_SMS_TOKEN=""

# 5. Telegram Bot Alerts (Merchant & Addis Ababa Courier Fleet Alerts)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="849201948"
TELEGRAM_DISPATCH_CHAT_ID=""

# 6. AI & General Settings
GEMINI_API_KEY="AIzaSy..."
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
