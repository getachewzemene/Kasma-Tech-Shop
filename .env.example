# ==============================================================================
# Kasma Tech Shop - Production & Development Environment Configuration
# ==============================================================================

# 1. Database (Neon / Cloud SQL PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SQL_HOST="host"
SQL_DB_NAME="dbname"
SQL_USER="user"
SQL_PASSWORD="password"

# 2. Security & Administrator Authentication
JWT_SECRET="kasma-super-secret-jwt-key-2026-secure-ethiopia"
ADMIN_USERNAME="kasma-admin"
ADMIN_PASSWORD="strong_admin_password_here"

# 3. V1 MVP Payment Setup (Cash on Delivery & Manual Bank Transfer / Telebirr with Receipt Upload)
# Note: Chapa automated payment rails (Telebirr, CBE Birr, Awash, Bank Cards) are ready for V2 activation
# upon completion of Ethiopian regulatory trade license verification.
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxx"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxx"
CHAPA_WEBHOOK_SECRET="kasma_chapa_webhook_secret_2026"
CHAPA_BASE_URL="https://api.chapa.co/v1"

# 4. Ethiopian SMS Gateway (AfroMessage & Ethio Telecom - V2 Automated OTPs)
AFROMESSAGE_API_KEY="your_afromessage_api_key_here"
AFROMESSAGE_SENDER_NAME="KASMA"
AFROMESSAGE_IDENTIFIER_ID=""

# 5. Telegram Bot Alerts & Multi-Channel Notifications (V1 MVP Primary Channel)
# Create a bot via @BotFather on Telegram to receive real order alerts to your merchant/admin group:
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="849201948"
TELEGRAM_DISPATCH_CHAT_ID=""

# 6. Customer Facing Messaging & Support (V1 MVP 1-Click Sharing)
VITE_TELEGRAM_SUPPORT_USERNAME="KasmaTechSupport"
VITE_WHATSAPP_SUPPORT_NUMBER="251911223344"

# 7. AI & General Settings
GEMINI_API_KEY="AIzaSy..."
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
